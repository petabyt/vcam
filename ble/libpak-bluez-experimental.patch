 int pak_bt_device_create_bond(struct PakBt *ctx, struct PakBtDevice *device, int blocking) {
-	// TODO:
-	return -1;
+	struct PakBtDeviceWrapper *wrapper = to_wrapper(device);
+	DBusMessage *call = dbus_message_new_method_call("org.bluez", wrapper->path, "org.bluez.Device1", "Pair");
+	DBusPendingCall *pending = NULL;
+	if (!call) return -1;
+	if (!dbus_connection_send_with_reply(ctx->conn, call, &pending, 60000) || !pending) {
+		dbus_message_unref(call);
+		return -1;
+	}
+	dbus_message_unref(call);
+	while (!dbus_pending_call_get_completed(pending)) {
+		if (!dbus_connection_read_write_dispatch(ctx->conn, 100)) {
+			dbus_pending_call_cancel(pending);
+			dbus_pending_call_unref(pending);
+			return -1;
+		}
+	}
+	DBusMessage *reply = dbus_pending_call_steal_reply(pending);
+	dbus_pending_call_unref(pending);
+	if (!reply) return -1;
+	int ok = dbus_message_get_type(reply) == DBUS_MESSAGE_TYPE_METHOD_RETURN ||
+		dbus_message_is_error(reply, "org.bluez.Error.AlreadyExists");
+	if (!ok) fprintf(stderr, "BlueZ Pair failed: %s\n", dbus_message_get_error_name(reply));
+	dbus_message_unref(reply);
+	return ok ? 0 : -1;
 }
 
